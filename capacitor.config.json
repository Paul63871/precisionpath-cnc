{
  "appId": "com.precisionpath.cnc",
  "appName": "PrecisionPath CNC",
  "webDir": "dist",
  "backgroundColor": "#0f172a",
  "server": {
    "androidScheme": "https"
  },
  "ios": {
    "contentInset": "automatic",
    "backgroundColor": "#0f172a"
  },
  "android": {
    "backgroundColor": "#0f172a",
    "allowMixedContent": false
  },
  "plugins": {
    "SplashScreen": {
      "launchShowDuration": 400,
      "backgroundColor": "#0f172a",
      "androidScaleType": "CENTER_CROP",
      "showSpinner": false
    }
  }
}
