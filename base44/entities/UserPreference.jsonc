{
  "name": "UserPreference",
  "type": "object",
  "properties": {
    "aggressiveness": {
      "type": "number"
    },
    "units": {
      "type": "string",
      "enum": [
        "imperial",
        "metric"
      ],
      "default": "imperial"
    }
  },
  "rls": {
    "read": {
      "created_by_id": "{{user.id}}"
    },
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "update": {
      "created_by_id": "{{user.id}}"
    },
    "delete": {
      "created_by_id": "{{user.id}}"
    }
  }
}