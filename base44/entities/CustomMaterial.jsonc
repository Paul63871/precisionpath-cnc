      "type": "number"
    },
    "sfm_max": {
      "type": "number"
    },
    "chip_load_factor": {
      "type": "number"
    },
    "hp_factor": {
      "type": "number"
    },
    "slot_depth_factor": {
      "type": "number"
    },
    "profile_depth_factor": {
      "type": "number"
    }
  },
  "required": [
